# Database Configuration
# SQLite (default)
DATABASE_URL=sqlite:///./hintify.db
# PostgreSQL example: postgresql://user:password@localhost:5432/hintify
# MySQL example: mysql://user:password@localhost:3306/hintify

# AI Provider Configuration
# Options: openai | deepseek | local | fallback
AI_PROVIDER=fallback
# Leave empty to use fallback (no API calls)
AI_API_KEY=
# Model name (e.g., gpt-3.5-turbo, gpt-4, deepseek-chat)
AI_MODEL=gpt-3.5-turbo

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Security
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Cache Configuration
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=1000
